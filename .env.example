# NotionHealth AI Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Notion Configuration
# ===========================================
# Get your API key from: https://www.notion.so/my-integrations
NOTION_API_KEY=your_notion_integration_token_here

# Database IDs (filled automatically by python scripts/setup_notion.py)
# Format: 32-char hex from the Notion database URL
NOTION_HEALTH_DATABASE_ID=
NOTION_MEDICATION_DATABASE_ID=
NOTION_APPOINTMENT_DATABASE_ID=
NOTION_GOALS_DATABASE_ID=
NOTION_SYMPTOMS_DATABASE_ID=
NOTION_BRAIN_DATABASE_ID=

# ===========================================
# AI Configuration
# ===========================================
# Anthropic API key for Claude (required for AI insights)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API key (optional — for GPT-4o provider in the web GUI)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API key (optional — for Gemini 2.0 Flash provider in the web GUI)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# HuggingFace token — needed ONLY to run real TRIBEv2 model weights
# Without this, fast simulation-based brain analysis is used (all tools still work)
# Steps:
#   1. Request access to the gated model: huggingface.co/meta-llama/Llama-3.2-3B
#      (approved within minutes)
#   2. Create a Read token at: huggingface.co/settings/tokens
HUGGING_FACE_TOKEN=your_hf_token_here

# AI Model Selection (used by CLI/MCP server; web GUI lets users pick per-request)
AI_MODEL_PROVIDER=anthropic  # Options: anthropic, openai
AI_MODEL_NAME=claude-sonnet-4-6

# ===========================================
# MCP Server Configuration
# ===========================================
MCP_SERVER_NAME=notion-health-ai
MCP_SERVER_VERSION=2.1.0
MCP_TRANSPORT=stdio  # stdio (Claude Desktop) or sse (HTTP)

# ===========================================
# Web API Configuration (optional overrides)
# ===========================================
# API_HOST=0.0.0.0
# API_PORT=8000

# ===========================================
# Health Tracking Configuration
# ===========================================
HEALTH_DATA_RETENTION_DAYS=365
REMINDER_CHECK_INTERVAL_MINUTES=15
AI_INSIGHTS_REFRESH_HOURS=6
TIMEZONE=UTC

# ===========================================
# Feature Flags
# ===========================================
ENABLE_AI_INSIGHTS=true
ENABLE_MEDICATION_REMINDERS=true
ENABLE_APPOINTMENT_REMINDERS=true
ENABLE_SYMPTOM_ANALYSIS=true
ENABLE_GOAL_TRACKING=true

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=INFO
LOG_FILE=logs/notion-health-ai.log

# ===========================================
# Security
# ===========================================
ENABLE_DATA_ENCRYPTION=false
